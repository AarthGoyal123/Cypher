 = gt[\"matched_entity_ids\"].map(parse_matches)\n","\n","gt[\"match_count\"] = gt[\"matched_ids\"].map(len)\n","\n","\n","# ------------------------------------------------------------\n","# Match-count distribution\n","# ------------------------------------------------------------\n","\n","print(\"=\" * 80)\n","print(\"MATCH COUNT DISTRIBUTION\")\n","print(\"=\" * 80)\n","\n","print(\n","    gt[\"match_count\"]\n","    .value_counts()\n","    .sort_index()\n","    .to_string()\n",")\n","\n","print()\n","\n","\n","# ------------------------------------------------------------\n","# Summary statistics\n","# ------------------------------------------------------------\n","\n","print(\"=\" * 80)\n","print(\"GROUND TRUTH SUMMARY\")\n","print(\"=\" * 80)\n","\n","print(f\"Total S1 entities       : {len(gt):,}\")\n","print(\n","    f\"Singleton / no-match    : \"\n","    f\"{(gt['match_count'] == 0).sum():,}\"\n",")\n","print(\n","    f\"Entities with matches   : \"\n","    f\"{(gt['match_count'] > 0).sum():,}\"\n",")\n","print(\n","    f\"Maximum matches/entity  : \"\n","    f\"{gt['match_count'].max():,}\"\n",")\n","print(\n","    f\"Average matches/entity  : \"\n","    f\"{gt['match_count'].mean():.3f}\"\n",")\n","\n","print()\n","\n","\n","# ------------------------------------------------------------\n","# Check that matched IDs belong to S2 or S3\n","# ------------------------------------------------------------\n","\n","invalid_prefix_rows = gt[\n","    gt[\"matched_ids\"].map(\n","        lambda ids: any(\n","            not (\n","                entity_id.startswith(\"S2-\")\n","                or entity_id.startswith(\"S3-\")\n","            )\n","            for entity_id in ids\n","        )\n","    )\n","]\n","\n","print(\n","    \"Invalid match-prefix rows:\",\n","    len(invalid_prefix_rows)\n",")\n","\n","assert len(invalid_prefix_rows) == 0\n","\n","\n","# ------------------------------------------------------------\n","# Show examples\n","# ------------