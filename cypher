ames']:,}\")\n","        print(f\"Blank addresses:         {audit['blank_addresses']:,}\")\n","        print(f\"Literal null addresses:  {audit['literal_null_addresses']:,}\")\n","        print(f\"Blank countries:         {audit['blank_countries']:,}\")\n","        print(f\"Countries:               {audit['countries']}\")"]},{"cell_type":"code","execution_count":5,"id":"810bd933","metadata":{"execution":{"iopub.execute_input":"2026-09-25T15:02:18.559793Z","iopub.status.busy":"2026-09-25T15:02:18.559444Z","iopub.status.idle":"2026-09-25T15:02:18.646984Z","shell.execute_reply":"2026-09-25T15:02:18.645666Z"},"papermill":{"duration":0.096017,"end_time":"2026-09-25T15:02:18.64954+00:00","exception":false,"start_time":"2026-09-25T15:02:18.553523+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Multilingual normalization test\n","================================================================================\n","RAW : Léarning Center\n","NORM: learning center\n","\n","RAW : Àmicale\n","NORM: amicale\n","\n","RAW : राम मार्केटिंग प्राइवेट लिमिटेड\n","NORM: राम मार्केटिंग प्राइवेट लिमिटेड\n","\n","RAW : मॉडर्न फाइनेंस\n","NORM: मॉडर्न फाइनेंस\n","\n","RAW : ಕರ್ನಾಟಕ\n","NORM: ಕರ್ನಾಟಕ\n","\n","RAW : B+ Retail Inc\n","NORM: b retail\n","\n","Address normalization test\n","================================================================================\n","RAW : 17560 Ellis Road, Tahlequah, OK\n","NORM: 17560 ellis rd tahlequah ok\n","\n","RAW : 63 R. DE DIEPPE, LILLE, Hauts-de-France\n","NORM: 63 r de dieppe lille hauts de france\n","\n","RAW : No 10 Enkay Square, 448A, Udyog Vihar Phase V\n","NORM: number 10 enkay square 448a udyog vihar phase v\n","\n","RAW : 5780 Fawn Ct, Fort Worth, Texas\n","NORM: 5780 fawn ct fort worth texas\n","\n","RAW : H.no 910 A 3503, Mumbai, महाराष्ट्र\n","NORM: h number 910 a 3503 mumbai महाराष्ट्र\n","\n","✅ FINAL Unicode-safe normalization functions loaded.\n"]}],"source":["# CELL 5 — FINAL Unicode-safe normalization\n","# Preserves Devanagari, Kannada, French accents, numbers, etc.\n","\n","import unicodedata\n","import pandas as pd\n","\n","\n","# ------------------------------------------------------------\n","# 1. Unicode-safe text normalization\n","# ------------------------------------------------------------\n","\n","def normalize_text(value):\n","\n","    if pd.isna(value):\n","        return \"\"\n","\n","    text = str(value).strip().lower()\n","\n","    # Unicode compatibility normalization\n","    text = unicodedata.normalize(\"NFKC\", text)\n","\n","    cleaned = []\n","\n","    for char in text:\n","\n","        category = unicodedata.category(char)\n","\n","        # Preserve:\n","        # L = Letters\n","        # M = Combining marks\n","        # N = Numbers\n","        # Z = Unicode separators / whitespace\n","        if (\n","            category.startswith(\"L\")\n","            or category.startswith(\"M\")\n","            or category.startswith(\"N\")\n","            or category.startswith(\"Z\")\n","        ):\n","            cleaned.append(char)\n","        else:\n","            # punctuation / symbols -> space\n","            cleaned.append(\" \")\n","\n","    text = \"\".join(cleaned)\n","\n","    # Collapse whitespace\n","    text = \" \".join(text.split())\n","\n","    return text\n","\n","\n","# ------------------------------------------------------------\n","# 2. Remove accents ONLY from Latin characters\n","# ------------------------------------------------------------\n","\n","def normalize_latin_accents(text):\n","\n","    result = []\n","\n","    for char in text:\n","\n","        char_name = unicodedata.name(char, \"\")\n","\n","        if \"LATIN\" in char_name:\n","\n","            decomposed = unicodedata.normalize(\n","                \"NFKD\",\n","                char\n","            )\n","\n","            for dchar in decomposed:\n","\n","                if not unicodedata.combining(dchar):\n","                    result.append(dchar)\n","\n","        else:\n","            # IMPORTANT:\n","            # Keep Indic and every other non-Latin character intact.\n","            result.append(char)\n","\n","    return \"\".join(result)\n","\n","\n","# ------------------------------------------------------------\n","# 3. Business name normalization\n","# ------------------------------------------------------------\n","\n","LEGAL_SUFFIXES = {\n","    \"incorporated\",\n","    \"inc\",\n","    \"corporation\",\n","    \"corp\",\n","    \"limited\",\n","    \"ltd\",\n","    \"llc\",\n","    \"llp\",\n","    \"plc\",\n","    \"private\",\n","    \"pvt\",\n","    \"company\",\n","    \"co\",\n","    \"sa\",\n","    \"sas\",\n","}\n","\n","\n","def normalize_business_name(value):\n","\n","    text = normalize_text(value)\n","\n","    if not text:\n","        return \"\"\n","\n","    # Remove Latin accents only\n","    text = normalize_latin_accents(text)\n","\n","    tokens = text.split()\n","\n","    # Remove legal suffixes from the edges\n","    while tokens and tokens[-1] in LEGAL_SUFFIXES:\n","        tokens.pop()\n","\n","    while tokens and tokens[0] in LEGAL_SUFFIXES:\n","        tokens.pop(0)\n","\n","    return \" \".join(tokens)\n","\n","\n","# ------------------------------------------------------------\n","# 4. Address normalization\n","# ------------------------------------------------------------\n","\n","ADDRESS_ABBREVIATIONS = {\n","\n","    # English / US\n","    \"street\": \"st\",\n","    \"road\": \"rd\",\n","    \"avenue\": \"ave\",\n","    \"boulevard\": \"blvd\",\n","    \"drive\": \"dr\",\n","    \"lane\": \"ln\",\n","    \"court\": \"ct\",\n","    \"highway\": \"hwy\",\n","    \"parkway\": \"pkwy\",\n","    \"place\": \"pl\",\n","    \"suite\": \"ste\",\n","    \"apartment\": \"apt\",\n","\n","    # General\n","    \"no\": \"number\",\n","    \"floor\": \"fl\",\n","\n","    # Common variants\n","    \"bd\": \"boulevard\",\n","    \"av\": \"avenue\",\n","}\n","\n","\n","def normalize_address(value):\n","\n","    if pd.isna(value):\n","        return \"\"\n","\n","    text = str(value).strip().lower()\n","\n","    if text in {\"\", \"null\", \"none\", \"nan\"}:\n","        return \"\"\n","\n","    text = normalize_text(text)\n","\n","    if not text:\n","        return \"\"\n","\n","    text = normalize_latin_accents(text)\n","\n","    tokens = text.split()\n","\n","    normalized_tokens = [\n","        ADDRESS_ABBREVIATIONS.get(token, token)\n","        for token in tokens\n","    ]\n","\n","    return \" \".join(normalized_tokens)\n","\n","\n","# ------------------------------------------------------------\n","# 5. Country normalization\n","# ------------------------------------------------------------\n","\n","def normalize_country(value):\n","\n","    if pd.isna(value):\n","        return \"\"\n","\n","    return str(value).strip().casefold()\n","\n","\n","# ------------------------------------------------------------\n","# 6. Entity ID normalization\n","# ------------------------------------------------------------\n","\n","def normalize_entity_id(value):\n","\n","    if pd.isna(value):\n","        return \"\"\n","\n","    return str(value).strip()\n","\n","\n","# ------------------------------------------------------------\n","# 7. CRITICAL MULTILINGUAL TEST\n","# ------------------------------------------------------------\n","\n","examples = [\n","    \"Léarning Center\",\n","    \"Àmicale\",\n","    \"राम मार्केटिंग प्राइवेट लिमिटेड\",\n","    \"मॉडर्न फाइनेंस\",\n","    \"ಕರ್ನಾಟಕ\",\n","    \"B+ Retail Inc\",\n","]\n","\n","print(\"Multilingual normalization test\")\n","print(\"=\" * 80)\n","\n","for value in examples:\n","\n","    result = normalize_business_name(value)\n","\n","    print(f\"RAW : {value}\")\n","    print(f\"NORM: {result}\")\n","    print()\n","\n","\n","# ------------------------------------------------------------\n","# 8. Address test\n","# -----------------------------------------------------