p.asarray(indices)\n","\n","    # Shuffle ONLY S1 entities within this match-count group\n","    shuffled = indices.copy()\n","    rng.shuffle(shuffled)\n","\n","    n_validation = int(\n","        round(len(shuffled) * VALIDATION_FRACTION)\n","    )\n","\n","    validation_indices = shuffled[:n_validation]\n","\n","    split_df.loc[\n","        validation_indices,\n","        \"split\"\n","    ] = \"validation\"\n","\n","\n","# ------------------------------------------------------------\n","# Sanity checks\n","# ------------------------------------------------------------\n","\n","assert len(split_df) == len(gt)\n","\n","assert split_df[\"source1_entity_id\"].is_unique\n","\n","assert (\n","    split_df[\"split\"].value_counts().sum()\n","    == len(split_df)\n",")\n","\n","assert set(split_df[\"split\"].unique()) == {\n","    \"train\",\n","    \"validation\"\n","}\n","\n","\n","# ------------------------------------------------------------\n","# Verify no S1 entity appears in both partitions\n","# ------------------------------------------------------------\n","\n","train_ids = set(\n","    split_df.loc[\n","        split_df[\"split\"] == \"train\",\n","        \"source1_entity_id\"\n","    ]\n",")\n","\n","validation_ids = set(\n","    split_df.loc[\n","        split_df[\"split\"] == \"validation\",\n","        \"source1_entity_id\"\n","    ]\n",")\n","\n","assert train_ids.isdisjoint(validation_ids)\n","\n","\n","# ------------------------------------------------------------\n","# Save compact validation metadata\n","# ------------------------------------------------------------\n","\n","output_path = os.path.join(\n","    VALIDATION_DIR,\n","    \"ground_truth_entity_split.tsv\"\n",")\n","\n","save_df = split_df.copy()\n","\n","# Store matched IDs as comma-separated text\n","save_df[\"matched_entity_ids\"] = save_df[\n","    \"matched_ids\"\n","].map(\",\".join)\n","\n","save_df = save_df[\n","    [\n","        \"source1_entity_id\",\n","        \"matched_entity_ids\",\n","        \"match_count\",\n","        \"split\",\n","    ]\n","]\n","\n","save_df.to_csv(\n","    output_path,\n","    sep=\"\\t\",\n","    index=False\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Report overall split\n","# ------------------------------------------------------------\n","\n","print(\"=\" * 80)\n","print(\"ENTITY-LEVEL VALIDATION SPLIT\")\n","print(\"=\" * 80)\n","\n","print(\n","    split_df[\"split\"]\n","    .value_counts()\n","    .to_string()\n",")\n","\n","print()\n","\n","print(\n","    f\"Total entities     : {len(split_df):,}\"\n",")\n","\n","print(\n","    f\"Training entities  : {len(train_ids):,}\"\n",")\n","\n","print(\n","    f\"Validation entities: {len(validation_ids):,}\"\n",")\n","\n","print(\n","    f\"Validation fraction: \"\n","    f\"{len(validation_ids) / len(split_df):.4%}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Match-count distribution by split\n","# ------------------------------------------------------------\n","\n","print()\n","print(\"=\" * 80)\n","print(\"MATCH-COUNT DISTRIBUTION BY SPLIT\")\n","print(\"=\" * 80)\n","\n","distribution = pd.crosstab(\n","    split_df[\"match_count\"],\n","    split_df[\"split\"]\n",")\n","\n","distribution[\"total\"] = distribution.sum(axis=1)\n","\n","distribution[\"validation_pct\"] = (\n","    distribution[\"validation\"]\n","    / distribution[\"total\"]\n","    * 100\n",")\n","\n","print(distribution.to_string())\n","\n","\n","# ------------------------------------------------------------\n","# Singleton / zero-match preservation\n","# ------------------------------------------------------------\n","\n","print()\n","print(\"=\" * 80)\n","print(\"ZERO-MATCH ENTITY CHECK\")\n","print(\"=\" * 80)\n","\n","zero_match = split_df[\n","    split_df[\"match_count\"] == 0\n","]\n","\n","print(\n","    f\"Total zero-match entities       : \"\n","    f\"{len(zero_match):,}\"\n",")\n","\n","print(\n","    f\"Zero-match training entities    : \"\n","    f\"{(zero_match['split'] == 'train').sum():,}\"\n",")\n","\n","print(\n","    f\"Zero-match validation entities  : \"\n","    f\"{(zero_match['split'] == 'validation').sum():,}\"\n",")\n","\n","\n","print()\n","print(f\"Saved to: {output_path}\")\n","print(\"✅ Entity-level validation split created.\")"]},{"cell_type":"code","execution_count":10,"id":"b7b6745f","metadata":{"execution":{"iopub.execute_input":"2026-09-25T15:27:04.432774Z","iopub.status.busy":"2026-09-25T15:27:04.432418Z","iopub.status.idle":"2026-09-25T15:27:04.451998Z","shell.execute_reply":"2026-09-25T15:27:04.45084Z"},"papermill":{"duration":0.039462,"end_time":"2026-09-25T15:27:04.453994+00:00","exception":false,"start_time":"2026-09-25T15:27:04.414532+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["================================================================================\n","F0.5 SCORER UNIT TESTS\n","================================================================================\n","Test 1 — perfect match:        PASS\n","Test 2 — empty → empty:        PASS\n","Test 3 — false positive singleton: PASS\n","Test 4 — completely wrong:     PASS\n","Test 5 — partial match:         PASS (F0.5=0.8333)\n","Test 6 — false positive:       PASS (F0.5=0.5556)\n","\n","Macro F0.5 test score: 0.944444\n","\n","✅ Shared F0.5 scorer is ready.\n"]}],"source":["# CELL 10 — Shared Macro F0.5 Scorer\n","# Challenge metric: macro-average per Source-1 entity\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","BETA = 0.5\n","BETA_SQUARED = BETA ** 2\n","\n","\n","def fbeta_single(\n","    true_ids,\n","    predicted_ids,\n","    beta=BETA,\n","):\n","    \"\"\"\n","    Calculate F_beta for ONE Source-1 entity.\n","\n","    Special case:\n","        true = empty\n","        prediction = empty\n","        -> score = 1.0\n","\n","        true = empty\n","        prediction != empty\n","        -> score = 0.0\n","    \"\"\"\n","\n","    true_set = set(true_ids)\n","    pred_set = set(predicted_ids)\n","\n","    # --------------------------------------------------------\n","    # Special singleton / zero-match handling\n","    # --------------------------------------------------------\n","\n","    if len(true_set) == 0:\n","\n","        if len(pred_set) == 0:\n","            return 1.0\n","\n","        return 0.0\n","\n","    # --------------------------------------------------------\n","    # Normal case\n","    # --------------------------------------------------------\n","\n","    true_positive = len(\n","        true_set & pred_set\n","    )\n","\n","    false_positive = len(\n","        pred_set - true_set\n","    )\n","\n","    false_negative = len(\n","        true_set - pred_set\n","    )\n","\n","    # Precision\n","    if true_positive + false_positive == 0:\n","        precision = 0.0\n","    else:\n","        precision = (\n","            true_positive\n","            / (true_positive + false_positive)\n","        )\n","\n","    # Recall\n","    if true_positive + false_negative == 0:\n","        recall = 0.0\n","    else:\n","        recall = (\n","            true_positive\n","            / (true_positive + false_negative)\n","        )\n","\n","    # F_beta\n","    denominator = (\n","        BETA_SQUARED * precision\n","        + recall\n","    )\n","\n","    if denominator == 0:\n","        return 0.0\n","\n","    return (\n","        (1 + BETA_SQUARED)\n","        * precision\n","        * recall\n","        / denominator\n","    )\n","\n","\n","def macro_f05(\n","    ground_truth,\n","    predictions,\n","):\n","    \"\"\"\n","    Calculate challenge-style macro F0.5.\n","\n","    Parameters\n","    ----------\n","    ground_truth:\n","        Dict:\n","            S1 entity ID -> iterable of true S2/S3 IDs\n","\n","    predictions:\n","        Dict:\n","            S1 entity ID -> iterable of predicted S2/S3 IDs\n","\n","    Returns\n","    -------\n","    float\n","        Macro F0.5 across ALL S1 entities.\n","    \"\"\"\n","\n","    scores = []\n","\n","    for s1_id, true_ids in ground_truth.items():\n","\n","        predicted_ids = predictions.get(\n","            s1_id,\n","            []\n","        )\n","\n","        score = fbeta_single(\n","            true_ids,\n","            predicted_ids,\n","            beta=BETA,\n","        )\n","\n","        scores.append(score)\n","\n","    if not scores:\n","        return 0.0\n","\n","    return float(\n","        np.mean(scores)\n","    )\n","\n","\n","def evaluate_predictions(\n","    ground_truth,\n","    predictions,\n","):\n","    \"\"\"\n","    Detailed evaluation for debugging.\n","\n","    Returns:\n","        overall macro F0.5\n","        per-entity scores\n","        summary statistics\n","    \"\"\"\n","\n","    rows = []\n","\n","    for s1_id, true_ids in ground_truth.items():\n","\n","        pred_ids = predictions.get(\n","            s1_id,\n","            []\n","        )\n","\n","        score = fbeta_single(\n","            true_ids,\n","            pred_ids,\n","        )\n","\n","        true_set = set(true_ids)\n","        pred_set = set(pred_ids)\n","\n","        tp = len(true_set & pred_set)\n","        fp = len(pred_set - true_set)\n","        fn = len(true_set - pred_set)\n","\n","        rows.append({\n","            \"source1_entity_id\": s1_id,\n","            \"true_count\": len(true_set),\n","            \"predicted_count\": len(pred_set),\n","            \"tp\": tp,\n","            \"fp\": fp,\n","            \"fn\": fn,\n","            \"f05\": score,\n","        })\n","\n","    result = pd.DataFrame(rows)\n","\n","    summary = {\n","        \"macro_f05\": result[\"f05\"].mean(),\n","        \"mean_precision\": (\n","            result[\"tp\"].sum()\n","            / max(\n","                result[\"tp\"].sum()\n","                + result[\"fp\"].sum(),\n","                1\n","            )\n","  