         5,082,316\n","Duplicate entity IDs:    0\n","Blank entity IDs:        0\n","IDs with outer spaces:   0\n","Blank business names:    0\n","Blank addresses:         136,098\n","Literal null addresses:  0\n","Blank countries:         0\n","Countries:               {'India': 2405000, 'France': 731615, 'US': 1945701}\n"]}],"source":["# CELL 4 — Full dataset quality audit\n","# Memory-safe and handles source files + ground truth separately\n","\n","import pandas as pd\n","from pathlib import Path\n","from collections import Counter\n","\n","INPUT_DIR = Path(\"/kaggle/input\")\n","\n","EXPECTED_FILES = [\n","    \"train_source1.tsv\",\n","    \"train_source2.tsv\",\n","    \"train_source3.tsv\",\n","    \"train_ground_truth.tsv\",\n","    \"test_source1.tsv\",\n","    \"test_source2.tsv\",\n","    \"test_source3.tsv\",\n","]\n","\n","\n","def find_file(filename):\n","    matches = list(INPUT_DIR.rglob(filename))\n","    if not matches:\n","        raise FileNotFoundError(f\"Could not find {filename}\")\n","    return matches[0]\n","\n","\n","def audit_source_file(path, chunk_size=100_000):\n","    total_rows = 0\n","    duplicate_ids = 0\n","    blank_ids = 0\n","    whitespace_ids = 0\n","    blank_names = 0\n","    blank_addresses = 0\n","    null_addresses = 0\n","    blank_countries = 0\n","\n","    seen_ids = set()\n","    countries = Counter()\n","\n","    for chunk in pd.read_csv(\n","        path,\n","        sep=\"\\t\",\n","        dtype=str,\n","        keep_default_na=False,\n","        chunksize=chunk_size\n","    ):\n","        total_rows += len(chunk)\n","\n","        ids = chunk[\"entity_id\"]\n","\n","        blank_ids += (ids.str.strip() == \"\").sum()\n","        whitespace_ids += (ids != ids.str.strip()).sum()\n","\n","        for entity_id in ids:\n","            if entity_id in seen_ids:\n","                duplicate_ids += 1\n","            else:\n","                seen_ids.add(entity_id)\n","\n","        names = chunk[\"business_name\"]\n","        blank_names += (names.str.strip() == \"\").sum()\n","\n","        addresses = chunk[\"business_address\"]\n","        blank_addresses += (addresses.str.strip() == \"\").sum()\n","\n","        null_addresses += addresses.str.strip().str.lower().isin(\n","            [\"null\", \"none\", \"nan\"]\n","        ).sum()\n","\n","        country_values = chunk[\"country\"].str.strip()\n","\n","        blank_countries += (country_values == \"\").sum()\n","\n","        countries.update(\n","            country_values[country_values != \"\"].tolist()\n","        )\n","\n","    return {\n","        \"rows\": total_rows,\n","        \"duplicate_ids\": duplicate_ids,\n","        \"blank_ids\": blank_ids,\n","        \"ids_with_outer_whitespace\": whitespace_ids,\n","        \"blank_names\": blank_names,\n","        \"blank_addresses\": blank_addresses,\n","        \"literal_null_addresses\": null_addresses,\n","        \"blank_countries\": blank_countries,\n","        \"countries\": dict(countries),\n","    }\n","\n","\n","def audit_ground_truth(path, chunk_size=100_000):\n","    total_rows = 0\n","    blank_source1_ids = 0\n","    duplicate_source1_ids = 0\n","    empty_match_lists = 0\n","    duplicate_matches = 0\n","\n","    seen_source1 = set()\n","\n","    for chunk in pd.read_csv(\n","        path,\n","        sep=\"\\t\",\n","        dtype=str,\n","        keep_default_na=False,\n","        chunksize=chunk_size\n","    ):\n","        total_rows += len(chunk)\n","\n","        s1_ids = chunk[\"source1_entity_id\"].str.strip()\n","        match_lists = chunk[\"matched_entity_ids\"].str.strip()\n","\n","        blank_source1_ids += (s1_ids == \"\").sum()\n","\n","        for s1_id in s1_ids:\n","            if s1_id in seen_source1:\n","                duplicate_source1_ids += 1\n","            else:\n","                seen_source1.add(s1_id)\n","\n","        empty_match_lists += (match_lists == \"\").sum()\n","\n","        # Check duplicate IDs inside each matche